// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum TransactionType {
  PURCHASE
  MARKET_PURCHASE
  TRADE_BUY
  TRADE_SELL
}

enum ItemType {
  WARFRAME_PART
  WEAPON_PART
  LANDING_CRAFT_PART
  COMPANION_PART
  ARCHWING_PART
  MOD
  RIVEN
  REACTOR
  CATALYST
  ARCANE_ADAPTER
  EXILUS_ADAPTER
  WARFRAME_SLOT
  WEAPON_SLOT
  ARCHWING_WEAPON_SLOT
  COMPANION_SLOT
  VEHICLE_SLOT
  COSMETIC
  PLATINUM
}

model Transaction {
  id                String            @id @default(cuid())
  date              DateTime          @default(now())
  transactionType   TransactionType
  itemType          ItemType
  itemName          String
  slug              String?           // warframe.market slug ID
  price             Int
  notes             String?

  @@map("transactions")
}

model WishlistItem {
  id                String            @id @default(cuid())
  slug              String            // warframe.market slug ID
  name              String
  itemType          ItemType          // lets a "buy" prefill a Transaction
  setId             String?           // null = standalone top-level entry
  notifyOnSale      Boolean           @default(true)   // poll & notify when this item is discounted
  saleNotifiedPrice Int?              // price we last notified at; null once price recovers above threshold

  set               ItemSet?          @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@map("wishlist_items")
}

model ItemSet {
  id                String            @id @default(cuid())
  name              String            // e.g. "Calibran Prime Set"

  items             WishlistItem[]    // relation to items in this set; query with orderBy: { id: "asc" } for stable order

  @@map("item_sets")
}