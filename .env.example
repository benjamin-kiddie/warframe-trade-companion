# Environment Variables for Warframe Trade Companion

# Used by `npx prisma migrate dev`/`generate` when working on the schema directly.
# The running app manages its own database path and doesn't read this.
DATABASE_URL="file:./data/database.db"

# Discord notifications for wishlist sale alerts
DISCORD_WEBHOOK_URL=""
WISHLIST_POLL_INTERVAL_MS=180000
WISHLIST_SALE_THRESHOLD_PERCENT=10
